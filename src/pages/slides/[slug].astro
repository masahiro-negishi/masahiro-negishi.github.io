---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { contentSlug } from "@/lib/slugs";

export async function getStaticPaths() {
  const decks = (await getCollection("slides", ({ data }) => !data.draft)).filter(
    (deck) => contentSlug(deck) !== "research-overview",
  );
  return decks.map((deck) => ({
    params: { slug: contentSlug(deck) },
    props: { deck },
  }));
}

const { deck } = Astro.props;
const { Content } = await render(deck);
---

<BaseLayout title={deck.data.title} description={deck.data.description}>
  <script is:inline>
    document.body.classList.add("deck");
  </script>
  <div class="deck-progress" aria-live="polite"></div>
  <Content />
  <script is:inline>
    const main = document.querySelector("main");
    const slides = Array.from(document.querySelectorAll(".deck-slide"));
    const progress = document.querySelector(".deck-progress");

    const updateProgress = () => {
      const index = Math.max(
        0,
        slides.findIndex((slide) => {
          const box = slide.getBoundingClientRect();
          return box.top >= -window.innerHeight / 2 && box.top < window.innerHeight / 2;
        }),
      );
      if (progress) progress.textContent = `${index + 1} / ${slides.length}`;
    };

    const go = (delta) => {
      const current = slides.findIndex((slide) => {
        const box = slide.getBoundingClientRect();
        return box.top >= -window.innerHeight / 2 && box.top < window.innerHeight / 2;
      });
      const next = Math.min(Math.max((current < 0 ? 0 : current) + delta, 0), slides.length - 1);
      slides[next]?.scrollIntoView({ behavior: "smooth" });
    };

    document.addEventListener("keydown", (event) => {
      if (["ArrowRight", "ArrowDown", "PageDown", " "].includes(event.key)) {
        event.preventDefault();
        go(1);
      }
      if (["ArrowLeft", "ArrowUp", "PageUp"].includes(event.key)) {
        event.preventDefault();
        go(-1);
      }
    });
    main?.addEventListener("scroll", updateProgress, { passive: true });
    updateProgress();
  </script>
</BaseLayout>
